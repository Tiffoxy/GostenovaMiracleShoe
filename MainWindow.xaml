<Window x:Class="GostenovaMiracleShow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GostenovaMiracleShow"
        mc:Ignorable="d"
        Title="GostenovaMiracleShow" Height="950" Width="1800" FontFamily="Calibri" Icon="/Res/Чудо Обувь.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Background="#D2F6E7"></StackPanel>
        <Image Source="/Res/Чудо Обувь.png" HorizontalAlignment="Left" Width="75"></Image>
        <TextBlock Text="GostenovaMiracleShow " FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <Button Name="BtnBack" Content="Назад" Click="BtnBack_Click" HorizontalAlignment="Right"></Button>
        <StackPanel Orientation="Horizontal" Background="#D2F6E7" Grid.Row="2"></StackPanel>
        <Frame Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"></Frame>
    </Grid>
</Window>
